# ===========================================
# Esteira de Demandas - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env com tokens reais.

# URL da API REST do GLPI (ajuste conforme sua instalação)
# Exemplos:
#   https://chamados.exemplo.com.br/apirest.php
#   https://chamados.exemplo.com.br/glpi/apirest.php
GLPI_API_URL=

# App-Token criado em: GLPI > Configurar > Geral > API
GLPI_APP_TOKEN=

# User Token do usuário da API: GLPI > Administração > Usuários > [usuário] > Configurações
GLPI_USER_TOKEN=

# Chave secreta para sessões (qualquer texto aleatório)
SESSION_SECRET=
